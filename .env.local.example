# Copy to .env.local and fill in.

# --- Demo mode (no backend needed) -----------------------------------------
# With these set (or with no Supabase URL at all) the app runs on built-in
# demo fixtures and fixture place-search. Remove both for real data.
NEXT_PUBLIC_DATA_MOCK=1
GEOCODE_MOCK=1

# --- Supabase (real mode) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used for the shared geocode cache/throttle, photo cleanup and seeding.
# Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Maps + Places ---------------------------------------------------
# Enable "Maps JavaScript API" and "Places API (New)" on the same Google Cloud
# project, then create an API key.
# Browser key (HTTP referrer: localhost and your Vercel domain) — map tiles.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Server key (API restriction: Places API (New) only) — search box.
# If this is empty, the server uses the public key above.
GOOGLE_MAPS_API_KEY=
