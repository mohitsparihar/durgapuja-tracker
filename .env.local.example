# Copy to .env.local and fill in.

# --- Demo mode (no backend needed) -----------------------------------------
# With these set (or with no Supabase URL at all) the app runs on built-in
# demo fixtures and fixture place-search. Remove both for real data.
NEXT_PUBLIC_DATA_MOCK=1
GEOCODE_MOCK=1

# --- Supabase (real mode) --------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: used for the shared geocode cache/throttle, photo cleanup and seeding.
# Never expose this to the browser (no NEXT_PUBLIC_ prefix).
SUPABASE_SERVICE_ROLE_KEY=

# --- Place search (Nominatim usage policy) ----------------------------------
# Identify your app and give a contact so OSM can reach you if needed.
NOMINATIM_USER_AGENT="PandalHop/1.0 (https://your-app.vercel.app)"
NOMINATIM_EMAIL=you@example.com
